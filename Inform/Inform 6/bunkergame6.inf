Constant Story "Bunker Blues";
Constant Headline "^By Nate^^";

Include "Parser";
Include "VerbLib";

Object  Suit "Survival Suit" selfobj
  with  name 'Suit' 'Survival',
        description "Survival Suit"
  has   clothing;

Object  Airlock "Airlock"
  with  description
            "Exits: S",
        s_to MainCorridor,
   has  light;

Object -> Pack "Emergency Pack"
  with  name 'Pack',
        description "Emergency Pack"
  has   clothing container openable;

Object -> -> Paper "Paper"
    with name 'Papers' 'Paper',
    before [; Examine:
         print "As you look at the papers the paperclip holding them together falls to the floor.";
         move paperclip to location;
         return true;
        ],    
;

Object Paperclip "Paperclip"
  with  name 'Paperclip',
        description "Paperclip"
;        

Object  MainCorridor "Main Corridor"
  with  description
            "Exits: N,S,W,E,SE,SW",
        n_to Airlock,
        s_to WECorridor,
        e_to BunkRoom,
        w_to Canteen,
        se_to Gym,
        sw_to Lounge,
   has  light;

Object ->  LightStick "Light Stick"
  with  name 'Light' 'Stick',
        description "Light Stick";

Object  Canteen "Canteen"
  with  description
            "Exits: E,S",
        s_to Kitchen,
        e_to MainCorridor,
;

Object ->  CoffeeFilter "Coffee Filter"
  with  name 'Coffee' 'Filter',
        description "Coffee Filter";

Object  BunkRoom "Bunk Room"
  with  description
            "Exits: S,W,E",
        s_to Latrine,
        e_to Closet,
        w_to MainCorridor,
;

Object  Closet "Closet"
  with  description
            "Exits: W",
        w_to BunkRoom,
;

Object ->  CodeBook "Code Book"
  with  name 'Code' 'Book',
        description "Code Book";

Object  Latrine "Latrine"
  with  description
            "Exits: N",
        n_to BunkRoom,
;

Object ->  ToiletBrush "Toilet Brush"
  with  name 'Toilet' 'Brush',
        description "Toilet Brush";

Object  Gym "Gym"
  with  description
            "Exits: S,W",
        s_to MedBay,
        w_to MainCorridor,
;

Object ->  Helmet "Helmet"
  with  name 'Helmet',
        description "Helmet";

Object ->  Hand "Hand"
  with  name 'Hand',
        description "Hand";

Object  MedBay "Med Bay"
  with  description
            "Exits: N,S",
        n_to Gym,
        s_to WECorridor,
has light;

Object ->  Pestle "Pestle"
  with  name 'Pestle',
        description "Pestle";

Object  Kitchen "Kitchen"
  with  description
            "Exits: N,S,W",
        n_to Canteen,
        s_to Pantry,
        w_to Storeroom,
;

Object ->  BreadKnife "Bread Knife"
  with  name 'Bread' 'Knife',
        description "Bread Knife";

Object  Storeroom "Storeroom"
  with  description
            "Exits: S,E",
        s_to Hydroponic,
        e_to Kitchen,
;

Object ->  Crowbar "Crowbar"
  with  name 'Crowbar',
        description "Crowbar";

Object  Hydroponic "Hydroponics"
  with  description
            "Exits: N,S,E",
        n_to Storeroom,
        s_to ToolRoom,
        e_to Pantry,
;

Object ->  BonsaiTree "Bonsai Tree"
  with  name 'Bonsai' 'Tree',
        description "Bonsai Tree";

Object  Pantry "Pantry"
  with  description
            "Exits: N,W",
        n_to Kitchen,
        w_to Hydroponic,
;

Object ->  Hose "Hose"
  with  name 'Hose',
        description "Hose";

Object  Library "Library"
  with  description
            "Exits: S",
        s_to Lounge,
;

Object ->  BoardShelf "Board Shelf"
  with  name 'Board' 'Shelf',
        description "Board (Shelf)";

Object  Lounge "Lounge"
  with  description
            "Exits: N,E",
        n_to Library,
        e_to MainCorridor,
;

Object  WECorridor "WE Corridor"
  with  description
            "Exits: N,S,E,SW,SE",
        n_to MainCorridor,
        s_to ControlRoom,
        e_to MedBay,
        se_to Generator,
        sw_to Workshop,
   has  light;

Object  ControlRoom "Control Room"
  with  description
            "Exits: N,S,W,E",
        n_to WECorridor,
        s_to Armoury,
        e_to Generator,
        w_to Workshop,
   has  light;

Object ->  Radio "Radio"
  with  name 'Radio',
        description "Radio";

Object  Workshop "Workshop"
  with  description
            "Exits: N,W,E",
        n_to WECorridor,
        e_to ControlRoom,
        w_to ToolRoom,
   has  light;

Object ->  Nozzle "Nozzle"
  with  name 'Nozzle',
        description "Nozzle";

Object ->  GasTank "Gas Tank"
  with  name 'Gas' 'Tank',
        description "Gas Tank";

Object  ToolRoom "Tool Room"
  with  description
            "Exits: N",
        n_to Hydroponic,
   has  light;

Object ->  WD40 "WD40"
  with  name 'WD40',
        description "WD40";

Object  Generator "Generator"
  with  description
            "Exits: N,W,E",
        n_to WECorridor,
        e_to PumpRoom,
        w_to ControlRoom,
   has  light;

Object ->  Switch "Switch"
  with  name 'Switch',
        description "Switch";

Object  PumpRoom "Pump Room"
  with  description
            "Exits: W,D",
        w_to Generator,
        d_to Reservoir,
   has  light;

Object ->  Knob "Knob"
  with  name 'Knob',
        description "Knob";

Object  Reservoir "Reservoir"
  with  description
            "Exits: U",
        u_to PumpRoom,
   has  light;

Object ->  Pipe "Pipe"
  with  name 'Pipe',
        description "Pipe";

Object  Armoury "Armoury"
  with  description
            "Exits: N",
        n_to ControlRoom,
   has  light;

Object ->  Weapon "Weapon"
  with  name 'Weapon',
        description "Weapon";

[ Initialise;
    location = Airlock;
    ! "^^Your opening paragraph here...^^";
];

Include "Grammar";

