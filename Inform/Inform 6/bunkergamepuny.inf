[ ScanSub;
    if (noun==hand) {
    ! hand
    }
];

Verb "shake" "jiggle" "wave"
	*   noun    -> Shake;

! Verb "saw" "sever" ! cut already in vocab?
!	*   noun    -> Cut;

! attach already in vocab?

Verb "spray" "apply" ! use on?
	*   noun    -> Spray;

Verb "lever" "wedge" ! pry? crank? move with?
	*   noun    -> Lever;

Verb "shoot" "fire"
	*   noun    -> Shoot;

Verb "lean" "lay" ! ramp?
	*   noun    -> Lean;

! Verb "type" "write" ! enter? copy?
!	*   noun    -> Type;
! already both in vocab

Verb "crush" "pound" "mix"
	*   noun    -> Crush;

Verb "weld" "fuse" "bond" "meld" "melt" "solder" ! attach/connect/join
	*   noun    -> Weld;

Verb "unblock" "empty" ! clear & clean in vocab
	*   noun    -> Unblock;

! Verb "scan" "hold" ! "press" already in vocab
