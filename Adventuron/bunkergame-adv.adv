 objects {
    paper    : object "a paper"    at="airlock";
    paperclip     : object "a paperclip"       at="airlock";
    suit     : object "a survival suit"    at="airlock";
    pack     : object "a pack"    at="airlock";

    stick    : object "a glow stick"    at="main_corridor";
    filter   : object "a coffee filter"    at="canteen"; # need to take from coffee machine
    book     : object "a code book"    at="closet";
    knife    : object "a bread knife"    at="kitchen";
    crowbar  : object "a crowbar"    at="storeroom";
    brush    : object "a toilet brush"    at="latrine";
    helmet   : object "a survival helmet"    at="gym";
    hand     : object "a severed hand"    at="gym";
    pestle   : object "a pestle"    at="med_bay";
    tree     : object "a bonsai tree"    at="hydroponic";
    hose     : object "a hose"    at="pantry";
    shelf    : object "a shelf"    at="library";
    torch    : object "a welding torch"    at="workshop"; #nozel - hose melted
    tank     : object "a tank of oxyfuel"    at="workshop";
    WD40     : object "a can of WD40"    at="tool_room"; # generic name?
    weapon   : object "a weapon"    at="armoury";
 # stationary
    radio    : object "a radio"    at="control_room";
    crewmate : object "a crew member"    at="gym";
 }
