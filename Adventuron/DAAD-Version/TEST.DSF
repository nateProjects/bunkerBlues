/PRO 0

> _       _      AT      0
                WINDOW 0
                CLS
                PROCESS 6

> _       _     WINDOW  0
; Set the boundries for the main text window

> _       _     WINDOW 1
#ifdef "pcw"
                BORDER  0
#endif
#ifdef "c64"
                BORDER  0
#endif
#ifndef "notspeccy"
                BORDER  0
#endif
#ifdef "pcw"
   WINAT   11       0 ;Leave enough space for graphic area + 8 pixels of margin
#endif
#ifdef "c64"
   WINAT   14       0 ; c64 images are always 12 rows
#endif
#ifndef "notspeccy"
   WINAT   11       0 ;Leave enough space for graphic area + 8 pixels of margin
#endif
#ifdef "pcw"
                INK 1
                PAPER 0
#endif
#ifdef "c64"
                INK 7
                PAPER 0
#endif
#ifndef "notspeccy"
                INK 1
                PAPER 0
#endif
#ifdef "pcw"
                WINSIZE 33      127
#endif
#ifdef "c64"
                WINSIZE 25      127
#endif
#ifndef "notspeccy"
                WINSIZE 25      127
#endif
                CLS

; Display the location graphics

> _       _     WINDOW 1
                CLS
> _       _       WINDOW  1
#ifdef "c64"
                XSPLITSCR 1
#endif
; XPOPX
#ifdef "pcw"
   WINAT   11       0 ;Leave enough space for graphic area + 8 pixels of margin
#endif
#ifdef "c64"
   WINAT   14       0 ; c64 images are always 12 rows
#endif
#ifndef "notspeccy"
   WINAT   11       0 ;Leave enough space for graphic area + 8 pixels of margin
#endif
#ifdef "pcw"
                WINSIZE 33      127
#endif
#ifdef "c64"
                WINSIZE 25      127
#endif
#ifndef "notspeccy"
                WINSIZE 25      127
#endif
> _       _     NOTSAME player_location_ previous_location_ ; If we just entered the location
                SET 113 ; then set the graphic into a dirty state
> _       _     WINDOW 1
                EXTERN  @player_location_ 0 ; Draw picture from disk bitmap corresponding to the current location id...
> _       _     CLEAR 113 ; Clear the dirty flag


; Display location text

> _       _       DESC    @player_location_ ; [Player]
