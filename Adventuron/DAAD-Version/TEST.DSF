/PRO 6 ; The startup routine (DAAD)

; Set the boundries for the main text window

> _       _     WINDOW 1
#ifdef "pcw"
                BORDER  0
#endif
#ifdef "c64"
                BORDER  0
#endif
#ifndef "notspeccy"
                BORDER  0
#endif
#ifdef "pcw"
   WINAT   11       0 ;Leave enough space for graphic area + 8 pixels of margin
#endif
#ifdef "c64"
   WINAT   14       0 ; c64 images are always 12 rows
#endif
#ifndef "notspeccy"
   WINAT   11       0 ;Leave enough space for graphic area + 8 pixels of margin
#endif
#ifdef "pcw"
                INK 1
                PAPER 0
#endif
#ifdef "c64"
                INK 7
                PAPER 0
#endif
#ifndef "notspeccy"
                INK 1
                PAPER 0
#endif
#ifdef "pcw"
                WINSIZE 33      127
#endif
#ifdef "c64"
                WINSIZE 25      127
#endif
#ifndef "notspeccy"
                WINSIZE 25      127
#endif
                CLS

                CLEAR   255

> _       _     NOTEQ   255     29 ; 29 = GFlags
                CLEAR   @255

> _       _     PLUS    255     1
                LT      255     255
                SKIP    -2

> _       _     RESET
                LET 113 255 ; Mark the graphics view as dirty
                LET     52 10 ; Strength
                LET     items_carryable_  10 ; Max Carry
                SET     46 ; CPNoun
                SET     47 ; CPAdject
                GOTO    0

